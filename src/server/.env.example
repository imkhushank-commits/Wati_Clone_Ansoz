# Copy this file to .env and fill in values from your own Meta app.
PORT=5000
FRONTEND_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/wati_clone

# Meta WhatsApp Cloud API credentials. These are NOT the same as your phone number.
WHATSAPP_ACCESS_TOKEN=PASTE_YOUR_META_ACCESS_TOKEN_HERE
WHATSAPP_PHONE_NUMBER_ID=PASTE_PHONE_NUMBER_ID_FROM_META_HERE
WHATSAPP_BUSINESS_ACCOUNT_ID=PASTE_WABA_ID_HERE
WHATSAPP_API_VERSION=v23.0
WHATSAPP_VERIFY_TOKEN=make-a-long-random-secret-token
WHATSAPP_APP_SECRET=PASTE_META_APP_SECRET_HERE

# Display/business number only. The number must be onboarded and verified in Meta.
WHATSAPP_BUSINESS_NUMBER=9340799391
